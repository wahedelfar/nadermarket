{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/oauth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|manifest.webmanifest|favicon|icon|robots.txt|sitemap.xml|api/).*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/api-server.js"
    },
    "api/trpc/[trpc].ts": {
      "includeFiles": "dist/api-server.js"
    }
  }
}
